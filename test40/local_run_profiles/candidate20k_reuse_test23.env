# Laptop-friendly 20k candidate profile that reuses the largest legacy entity
# pool currently available in this workspace: ../test23.
#
# These counts intentionally match test23's entity tables.  The run script then
# tops up only cheap procedural banks such as characters and titles.
RUN_PROFILE=candidate20k_reuse_test23
N_MOVIES=20000
START_YEAR=1950
END_YEAR=2025
N_PERSONS=38961
N_COMPANIES=2860
N_KEYWORDS=3631
N_CHARACTERS=340000
N_TITLES=29161
RERANK_BUDGET_MOVIES=1200
KEYWORD_RERANK_BUDGET_MOVIES=1200
STEP100_DISABLE_LLM=1
